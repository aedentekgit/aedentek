# Copy to /var/www/aedentek-crm-docker/.env.staging on the VPS (never commit the real file).
#   cp deploy/env.staging.example .env.staging && chmod 600 .env.staging
# Use a DIFFERENT secret from live:  openssl rand -hex 48
JWT_SECRET=REPLACE_WITH_96_HEX_CHARS_FROM_openssl_rand_hex_48
MONGODB_URI=mongodb://crm_staging:REPLACE_PASSWORD@host.docker.internal:27017/aedentek_crm_staging?authSource=admin
CLIENT_ORIGIN=https://staging.crm.aedentek.in
