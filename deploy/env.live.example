# Copy to /var/www/aedentek-crm-docker/.env.live on the VPS (never commit the real file).
#   cp deploy/env.live.example .env.live && chmod 600 .env.live
# Generate a secret with:  openssl rand -hex 48
JWT_SECRET=REPLACE_WITH_96_HEX_CHARS_FROM_openssl_rand_hex_48
# URL-encode special characters in the password (@ -> %40, # -> %23)
MONGODB_URI=mongodb://crm_live:REPLACE_PASSWORD@host.docker.internal:27017/aedentek_crm_live?authSource=admin
# Allowed browser origin for API calls
CLIENT_ORIGIN=https://crm.aedentek.in
