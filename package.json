{
  "name": "aedentek-crm",
  "version": "1.0.0",
  "description": "Aedentek CRM with separated Frontend (Screens) and Backend (Node.js + MongoDB)",
  "type": "module",
  "scripts": {
    "start": "npm run start --prefix backend",
    "backend": "npm run start --prefix backend",
    "backend:dev": "npm run dev --prefix backend",
    "frontend": "npm run dev --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "frontend:preview": "npm run preview --prefix frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm test --prefix backend",
    "test:frontend": "npm test --prefix frontend"
  },
  "keywords": [
    "crm",
    "aedentek",
    "sales-desk",
    "frontend",
    "backend",
    "mongodb",
    "nodejs",
    "admin-settings"
  ],
  "author": "Aedentek",
  "license": "MIT"
}
